# Dependencies
node_modules/

# Build
# NAO versionar `dist/`: o GitHub Actions gera a build no deploy. Versionar
# build output duplica cada bundle no repo e cria diffs enormes sem valor.
# (O repo tambem tem `dist/` no historico — ver `git rm -r --cached dist`.)
dist/
*.tsbuildinfo

# Ambiente
.env
.env.local
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Bubblewrap / TWA
# O projeto Android contem keystore e chave de assinatura — NUNCA versionar.
twa/*
!twa/README.md
*.keystore
*.jks

# Android
android/
android-app/
.gradle/
local.properties